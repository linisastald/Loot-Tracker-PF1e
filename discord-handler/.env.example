# Discord Configuration
DISCORD_PUBLIC_KEY=your_discord_public_key_here
PORT=3000

# Shared secret, the SAME value as DISCORD_BROKER_SECRET on every backend
# (required in production; generate with: openssl rand -hex 32)
DISCORD_BROKER_SECRET=your_shared_broker_secret_here

# Channels and callback URLs are registered by the backends at runtime
# (POST /register); there is no per-campaign configuration here.

# Optional: Override timeouts (milliseconds)
# REQUEST_TIMEOUT=2500
