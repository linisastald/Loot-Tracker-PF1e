# Discord Broker Configuration
# Copy this file to .env.discord-broker and fill in your values

# ==========================================
# REQUIRED: Discord Application Configuration
# ==========================================
# Get this from https://discord.com/developers/applications (General Information).
# The broker uses it to verify the signature of every Discord request.
DISCORD_PUBLIC_KEY=your_public_key_here
# The broker does not read a bot token, client id or guild id: the bot token is
# stored in the backend (Settings page) and used there.

# ==========================================
# Optional: Broker Security
# ==========================================
# REQUIRED in production: shared secret the backend(s) send in the X-Broker-Secret
# header on /register, /unregister and /heartbeat (and that the broker sends back
# on every forward to a backend). Use the SAME value as DISCORD_BROKER_SECRET on
# each backend container. Generate with: openssl rand -hex 32
DISCORD_BROKER_SECRET=your_shared_broker_secret_here
# Rollout only: set to true so backends that predate the shared secret can still
# register/heartbeat while you update them one at a time. Remove when all are updated.
# BROKER_ALLOW_UNAUTHENTICATED_CONTROL=true
# Optional: comma-separated hosts a registered callback endpoint may point at
# (e.g. rotr.example.com,sns.example.com). When unset any http(s) URL is accepted.
# BROKER_ALLOWED_ENDPOINT_HOSTS=

# ==========================================
# Optional: Service Configuration (defaults shown)
# ==========================================
# PORT=3000
# NODE_ENV=production
# REQUEST_TIMEOUT=2500   # ms allowed for a backend to answer a button click