# Docker Environment Variables Template (placeholders only)
# Copy this file to .env.docker (gitignored) and fill in your actual values.
# NEVER commit the real file.
#
# The application is one container (docker/Dockerfile.backend) plus the optional Discord
# broker container (discord-handler/Dockerfile). Deployment definitions (for example
# TrueNAS app yaml) are kept outside git. This file lists the variables those definitions
# pass to the containers; the complete backend list, with comments, is backend/.env.example.
# Generate random secrets with docker/generate-secrets.sh.

# --- Application container (backend serving the API and the built frontend) ---

# Database connection (owner credentials; also used by the migration runner)
DB_HOST=db
DB_PORT=5432
DB_NAME=loot_tracking
DB_USER=loot_user
DB_PASSWORD=generate_a_very_strong_password_here

# Dedicated NON-owner application role. REQUIRED in production: set both so PostgreSQL
# row-level security (campaign isolation) is enforced. With NODE_ENV=production the server
# refuses to start without them (it would run as the owner and bypass RLS).
DB_APP_USER=loot_app
DB_APP_PASSWORD=generate_a_different_strong_password_here

# Secrets, REQUIRED in production, each at least 32 characters (generate with: openssl rand -hex 32).
# With NODE_ENV=production the server refuses to start (listing every problem) if either is
# missing or too short, if DB_APP_* is unset, or if ALLOWED_ORIGINS is empty or contains '*'.
JWT_SECRET=generate_64_character_random_string_here
CSRF_SECRET=generate_another_64_character_random_string_here

# OpenAI API key (item parsing)
OPENAI_API_KEY=your_openai_api_key_here

# REQUIRED in production. Comma-separated list of the real origins users open the app from
# (scheme + host [+ port], no path). '*' is NOT accepted and production refuses to start with it.
# Use https:// origins only in production.
ALLOWED_ORIGINS=https://loot.yourdomain.com

# Email (optional, for password reset). Use ONE of the two modes.
# Mode 1 - Gmail (app password):
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Mode 2 - generic SMTP server (used when EMAIL_SERVICE is not "gmail"; SMTP_PORT defaults to 587, SMTP_SECURE=true for port 465):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
# Fallback base URL for the password reset link (the frontend_url setting takes precedence):
# FRONTEND_URL=https://loot.yourdomain.com

# --- Discord integration (backend side; optional) ---

# Where the backend finds the broker (leave unset to disable the integration)
DISCORD_BROKER_URL=http://discord-broker:3000

# --- Shared by the backend AND the Discord broker ---

# Shared secret; MUST be the same value on both sides. Generate with: openssl rand -hex 32
DISCORD_BROKER_SECRET=your_shared_broker_secret_here

# --- Discord broker container ---

# Discord application public key (REQUIRED): verifies the signature on every interaction
DISCORD_PUBLIC_KEY=your_discord_application_public_key_here
# Rollout only: "true" lets backends without the secret keep registering; remove afterwards
# BROKER_ALLOW_UNAUTHENTICATED_CONTROL=
# Optional: comma-separated hosts a registered callback endpoint may use
# BROKER_ALLOWED_ENDPOINT_HOSTS=
