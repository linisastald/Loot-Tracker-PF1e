# Root .dockerignore - exclude development and non-production files.
# Docker only reads this file from the build-context root (the repo root for
# docker/Dockerfile.backend), so there are deliberately no per-folder copies.

# Documentation (a bare *.md pattern only matches at the context root)
*.md
docs/

# Git files
.git/
.gitignore
.gitattributes
.github/

# IDE, editor and OS files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes

# Tests and coverage
**/__tests__/
**/*.test.js
**/*.spec.js
**/test/
**/tests/
coverage/
.nyc_output/
setupTests.js

# Installed dependencies and package-manager noise (installed fresh in the image)
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
pnpm-lock.yaml
.npm
.yarn/

# Build outputs (the frontend is built inside the image)
frontend/build/
frontend/dist/
dist/
build/
out/

# Logs, pids and temporary files
backend/logs/
logs/
pids/
*.log
*.pid
*.seed
*.pid.lock
tmp/
temp/
*.tmp
*.temp

# Development scripts and utilities (build_image.sh is the build entry point
# but is not needed inside the image either)
update_containers.sh
update_sql_data.sh
*.py
utilities/

# Environment files: secrets are supplied at deploy time, never baked into an image.
# ** prefixes also cover backend/.env and frontend/.env; the *.example templates stay.
**/.env
**/.env.*
!**/.env.example

# Docker helper files not needed in the image
docker/generate-secrets.sh
