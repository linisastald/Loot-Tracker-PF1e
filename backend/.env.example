# Backend Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loot_tracking
DB_USER=loot_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d

# OpenAI Configuration (for item parsing)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
NODE_ENV=production
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Email Configuration (optional, for password reset). Use ONE of the two modes.
# Mode 1 - Gmail (app password):
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Mode 2 - generic SMTP server (used when EMAIL_SERVICE is not "gmail"; SMTP_PORT defaults to 587, SMTP_SECURE=true for port 465):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
# Fallback base URL for the password reset link (the frontend_url setting takes precedence):
# FRONTEND_URL=https://yourdomain.com

# Discord Webhook (for notifications)
DISCORD_BROKER_SECRET=your_shared_broker_secret_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Logging
LOG_DIR=/app/backend/logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100