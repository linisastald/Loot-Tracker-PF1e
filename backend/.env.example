# Backend Environment Variables (placeholders only - never commit real values)
# Every name below is read by backend/src or backend/index.js.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loot_tracking
# Owner credentials: used by the migration runner (config/adminDb.js) and as the app
# fallback when the app role below is not set.
DB_USER=loot_user
DB_PASSWORD=your_secure_password_here
# Dedicated NON-owner application role. When both are set the app connects as this role
# and PostgreSQL row-level security (campaign isolation) is enforced. REQUIRED in production:
# with NODE_ENV=production the server refuses to start without both. Outside production,
# leaving them unset runs as the table owner, RLS is bypassed and it logs "RLS not enforced".
DB_APP_USER=loot_app
DB_APP_PASSWORD=your_app_role_password_here

# JWT Configuration
# REQUIRED in production, at least 32 characters (generate: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here_change_this
# Token lifetime (default 24h)
JWT_EXPIRES_IN=24h

# CSRF secret (double-submit cookie). REQUIRED in production, at least 32 characters
# (generate: openssl rand -hex 32). Outside production, if unset a random one is generated
# at startup, so every restart invalidates open sessions' CSRF tokens.
CSRF_SECRET=your_csrf_secret_here_change_this

# OpenAI Configuration (for item parsing)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
# With NODE_ENV=production the server REFUSES TO START (listing every problem) unless
# JWT_SECRET and CSRF_SECRET are >= 32 characters, DB_APP_USER and DB_APP_PASSWORD are set,
# and ALLOWED_ORIGINS lists real origins (no '*').
NODE_ENV=production
PORT=5000
# REQUIRED in production. Comma-separated list of the real origins users open the app from
# (scheme + host [+ port], no path), e.g. https://loot.example.com,http://192.168.1.10:5000.
# '*' is NOT accepted (production refuses to start with it). Requests without an Origin
# header (same-origin navigation, curl, health probes) are always allowed.
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Email Configuration (optional, for password reset). Use ONE of the two modes.
# Mode 1 - Gmail (app password):
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Mode 2 - generic SMTP server (used when EMAIL_SERVICE is not "gmail"; SMTP_PORT defaults to 587, SMTP_SECURE=true for port 465):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
# Fallback base URL for the password reset link (the frontend_url setting takes precedence):
# FRONTEND_URL=https://yourdomain.com

# Discord broker (optional; leave DISCORD_BROKER_URL unset to disable the integration)
# Base URL of the Discord broker service this backend registers with
DISCORD_BROKER_URL=http://discord-broker:3000
# Shared secret; MUST equal the broker's DISCORD_BROKER_SECRET. Generate with: openssl rand -hex 32
DISCORD_BROKER_SECRET=your_shared_broker_secret_here
# URL the broker uses to call this backend back (default is built from HOST_IP and PORT)
# DISCORD_CALLBACK_URL=http://backend-host:5000
# Overrides the broker identity (default: the built-in application name)
# GROUP_NAME=Pathfinder Loot Tracker

# Logging
LOG_DIR=/app/backend/logs
# LOG_LEVEL=info

# Rate limiting (defaults: 10000 ms window / 200 requests; auth routes 60000 ms / 20)
# RATE_LIMIT_WINDOW_MS=10000
# RATE_LIMIT_MAX_REQUESTS=200
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Optional tunables (defaults shown)
# MAX_LOGIN_ATTEMPTS=5
# ACCOUNT_LOCK_TIME=300000
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MAX_LENGTH=64
# USERNAME_MIN_LENGTH=5
# QUICK_INVITE_EXPIRY_HOURS=4
# COOKIE_MAX_AGE=86400000
# COOKIE_SAME_SITE=strict
# COOKIE_HTTP_ONLY=true
# DB_MAX_CONNECTIONS=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=10000
# DB_SLOW_QUERY_THRESHOLD=500
